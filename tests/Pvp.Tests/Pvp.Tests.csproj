<Project Sdk="Microsoft.NET.Sdk">
  <!-- Out-of-server tests: the pure core (rules, state, config, store) is compiled in directly, no Ramjet types needed.
       Run with: dotnet run in tests/Pvp.Tests (no engine needed) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Pvp.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../../src/Core/**/*.cs" />
  </ItemGroup>
</Project>
